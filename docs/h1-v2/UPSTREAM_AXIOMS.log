def ThreeSquares.DukeSquarefree : Prop :=
∀ (u : Fin 3 → ℝ),
  ∑ i, u i ^ 2 = 1 →
    ∀ ε > 0, ∃ T₀, ∀ (t : ℕ), T₀ ≤ t → Squarefree t → t % 8 = 3 → ∃ x, ∑ i, x i ^ 2 = ↑t ∧ ThreeSquares.Near u ε t x
def ThreeSquares.ThreeSquaresDense : Prop :=
∀ (u : Fin 3 → ℝ),
  ∑ i, u i ^ 2 = 1 → ∀ ε > 0, ∃ N₀, ∀ (n : ℕ), N₀ ≤ n → n % 8 = 3 → ∃ x, ∑ i, x i ^ 2 = ↑n ∧ ThreeSquares.Near u ε n x
